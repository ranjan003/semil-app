{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'super_admin' || root.child('users').child(auth.uid).child('role').val() == 'hr_admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
      }
    },

    "counters": { ".read": "auth != null", ".write": "auth != null" },
    "candidates": { ".read": "auth != null", ".write": "auth != null" },
    "vacancies": { ".read": "auth != null", ".write": "auth != null" },
