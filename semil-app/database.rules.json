    "assignments": { ".read": "auth != null", ".write": "auth != null" },
    "attempts": { ".read": "auth != null", ".write": "auth != null" },
    "importBatches": { ".read": "auth != null", ".write": "auth != null" },
    "auditLogs": { ".read": "auth != null", ".write": "auth != null" },
    "scoringConfig": { ".read": "auth != null", ".write": "auth != null" },
    "interviews": { ".read": "auth != null", ".write": "auth != null" },
    "offers": { ".read": "auth != null", ".write": "auth != null" },
