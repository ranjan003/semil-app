# Semil Talent Discovery — Environment Variables
# Copy to .env and fill in. Never commit the real .env.
#
# For Vercel: add these under Project → Settings → Environment Variables
# (Production, Preview and Development) and redeploy.

# ─── Core ───
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# ─── File Storage ───
STORAGE_SIGNING_SECRET=generate-with-openssl-rand-hex-32-xxxxxxxxxxxxxxxx

# ─── Email (SMTP) ───
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# SMTP_FROM=Semil Talent Discovery <noreply@semil.in>

# ─── Firebase web configuration (safe to expose to the browser) ───
FIREBASE_API_KEY=AIzaSyCdRMtDEgohaX74lylHfH0PrqDewTfR3Xw
FIREBASE_AUTH_DOMAIN=semil-a9cf1.firebaseapp.com
FIREBASE_DATABASE_URL=https://semil-a9cf1-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=semil-a9cf1
FIREBASE_STORAGE_BUCKET=semil-a9cf1.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=124354464493
FIREBASE_APP_ID=1:124354464493:web:06fc3d812bc641513c9ae4
FIREBASE_MEASUREMENT_ID=G-TZYB5VGRVH

# ─── Firebase Admin (server only — never put this in frontend code or a public repo) ───
# Create it at: Firebase Console → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"semil-a9cf1",...}
# FIREBASE_SERVICE_ACCOUNT_JSON=...same JSON, base64 is also accepted...
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json   # local only

# Comma-separated Firebase account e-mails that should be Super Admin.
# ADMIN_EMAILS=you@yourcompany.com

# Set to true in production once FIREBASE_SERVICE_ACCOUNT is configured.
# FIREBASE_DISABLE_RTDB_FALLBACK=true

# SESSION_SECRET=generate-with-openssl-rand-hex-32-xxxxxxxxxxxxxxxx
