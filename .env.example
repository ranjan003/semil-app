# Semil Talent Discovery — Environment Variables
# Copy to .env and fill in. Never commit the real .env.

# ─── Core ───
DATABASE_URL=postgres://semil:change-me@localhost:5432/semil
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# ─── File Storage ───
# Local disk (development):
STORAGE_ROOT=./storage
STORAGE_SIGNING_SECRET=generate-with-openssl-rand-hex-32-xxxxxxxxxxxxxxxx

# S3-compatible (production) — set S3_BUCKET to activate:
# S3_BUCKET=semil-files
# S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000          # MinIO / custom endpoint
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=true                   # true for MinIO

# ─── Email (SMTP) ───
# Leave SMTP_HOST empty to log emails to console (dev mode).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# SMTP_FROM=Semil Talent Discovery <noreply@semil.in>

# ─── Redis ───
# Leave empty for in-memory fallback (single server / dev).
# REDIS_URL=redis://localhost:6379

# ─── Docker Compose (used only by docker-compose.yml) ───
# POSTGRES_PASSWORD=semil_secret
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# PG_PORT=5432
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
