rules_version = '2';

// All application reads and writes go through the Express API, which uses the Firebase
// Admin SDK and enforces role permissions server-side. The browser never talks to
// Firestore directly, so clients are denied by default. This closes the previous
// public read/write exposure.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
